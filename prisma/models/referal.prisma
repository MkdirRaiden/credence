// prisma/models/referal.prisma

model ReferralCode {
  id              String   @id @default(uuid())
  ownerUserId     String
  code            String   @unique
  active          Boolean  @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  maxRedemptionsPerMonth Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner           User     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  redemptions     ReferralRedemption[]

  @@index([ownerUserId])
  @@index([active, startsAt, endsAt])
  @@index([code])  // For direct code lookups during redemption
  
}

model ReferralRedemption {
  id             String             @id @default(uuid())
  referrerId     String
  refereeId      String
  referralCodeId String
  status         RedemptionStatus   @default(PENDING)
  reason         String?
  idempotencyKey String?            @unique  // Prevent duplicate processing
  updatedAt      DateTime           @updatedAt
  createdAt      DateTime           @default(now())
  decidedAt      DateTime?
  decidedById    String? 
  deletedAt      DateTime? 

  referrer       User               @relation("Referrer", fields: [referrerId], references: [id], onDelete: Restrict)
  referee        User               @relation("Referee", fields: [refereeId], references: [id], onDelete: Restrict)
  decidedBy      User?              @relation("RedemptionDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  referralCode   ReferralCode       @relation(fields: [referralCodeId], references: [id], onDelete: Restrict)
  ledgerEntries  CreditLedger[]     @relation("RedemptionLedger")

  // Unique Constraints
  @@unique([referralCodeId, refereeId], name: "uniq_code_referee")  // One redemption per referee per code
  
  // Indexes
  @@index([referrerId, createdAt])  // For "my referrals" queries
  @@index([refereeId, createdAt])   // For "my referrers" queries
  @@index([referralCodeId])         // For "code redemptions" queries
  @@index([status, createdAt])      // For pending/approved/rejected reporting
  @@index([deletedAt])              // Index for soft delete queries
  @@index([status, deletedAt])
  @@index([decidedById])            // Track admin decisions
  @@index([status, decidedAt]) 
  
}
