LOG_LEVEL=DEBUG
NODE_ENV=development
PORT=5000
APP_NAME=Credence
APP_VERSION=1.0.0
GLOBAL_PREFIX=api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DatabaseName
SHADOW_DATABASE_URL=postgresql://SUPER_USER:PASSWORD@HOST:PORT/ShadowDatabaseName
JWT_SECRET=your_jwt_secret(32 characters long)
JWT_REFRESH_SECRET=your_jwt_refresh_secret(32 characters long)