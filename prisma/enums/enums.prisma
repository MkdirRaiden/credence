// prisma/enums/enums.prisma

enum UserRole {
  USER
  ADMIN
}

enum OtpChannel {
  SMS
  EMAIL
}

enum AuthProvider {
  LOCAL
  GOOGLE
  GITHUB
  APPLE
  SYSTEM  
}

enum RedemptionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED    // Admin revokes an approved redemption
}

enum CreditEvent {
  ISSUED       // Changed from ISSUE - Referral bonus issued
  REVOKED      // Changed from REVOKE - Credits removed (user delete, term violation)
  REFUNDED     // Changed from REFUND - Credits returned to user
  EXPIRED      // Changed from EXPIRE - Auto-expiration
  ADJUSTED     // Changed from ADJUSTMENT - Admin manual correction/dispute resolution
}

enum IdempotencyScope {
  API
  JOB
}

enum IdempotencyStatus {
  STARTED
  SUCCEEDED
  FAILED
}
