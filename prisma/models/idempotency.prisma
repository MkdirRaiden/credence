// prisma/models/idempotency.prisma

model IdempotencyRecord {
  id             String              @id @default(uuid())
  scope          IdempotencyScope
  idempotencyKey String
  status         IdempotencyStatus   @default(STARTED)
  fingerprint    String?
  responseHash   String?
  lockedAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // Unique Constraints
  @@unique([scope, idempotencyKey], name: "uniq_scope_idempotency_key")
  // Idempotency keys are unique per scope, not globally
  // e.g., API scope can have "req-123", JOB scope can also have "req-123"
  
  // Indexes for Query Performance
  @@index([expiresAt])                        // Cleanup: find expired records
  @@index([status, createdAt])                // Find hanging requests: WHERE status = 'STARTED' AND createdAt < ?
  @@index([scope, status, createdAt])         // Find pending requests per scope
  @@index([updatedAt])                        // Time-based queries
  
}
