// prisma/models/user.prisma

model User {
  // Core identity fields
  id           String   @id @default(uuid())
  email        String   @unique
  username     String?  @unique
  phone        String?  @unique
  passwordHash String?

  // Profile
  name         String?
  avatarUrl    String?

  // Verification
  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  // Authorization
  authProvider  AuthProvider    @default(LOCAL) 
  role UserRole @default(USER)

  // Referral tracking - who referred this user
  referredById String?

  // Timestamps
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lastLoginAt   DateTime? 
  deletedAt     DateTime?

  // Relations (no columns, only for queries)
  referredBy              User?                  @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals               User[]                 @relation("Referrals")
  redemptionsAsReferrer   ReferralRedemption[]   @relation("Referrer")
  redemptionsAsReferee    ReferralRedemption[]   @relation("Referee")
  redemptionsDecided      ReferralRedemption[]   @relation("RedemptionDecider")
  referralCodes           ReferralCode[]
  otps                    OtpCode[]
  refreshTokens           RefreshToken[]
  credits                 CreditLedger[]

  // Indexes
  @@index([deletedAt])
  @@index([email, deletedAt])
  @@index([referredById])  
  @@index([referredById, deletedAt])
  @@index([authProvider])                                    
  @@index([lastLoginAt]) 
  @@index([authProvider, email])                
}
