// prisma/models/referal.prisma

model ReferralCode {
  id              String   @id @default(uuid())
  ownerUserId     String
  code            String   @unique
  active          Boolean  @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  maxRedemptionsPerMonth Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  owner           User     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  redemptions     ReferralRedemption[]

  // Indexes
  @@index([ownerUserId])
  @@index([active, startsAt, endsAt])
}

model ReferralRedemption {
  id             String             @id @default(uuid())
  referrerId     String
  refereeId      String
  referralCodeId String
  status         RedemptionStatus   @default(PENDING)
  reason         String?
  idempotencyKey String?
  createdAt      DateTime           @default(now())
  decidedAt      DateTime?

  // Relations
  referrer       User               @relation("Referrer", fields: [referrerId], references: [id], onDelete: Restrict)
  referee        User               @relation("Referee", fields: [refereeId], references: [id], onDelete: Restrict)
  referralCode   ReferralCode       @relation(fields: [referralCodeId], references: [id], onDelete: Restrict)
  ledgerEntries  CreditLedger[]     @relation("RedemptionLedger")

  // Constraints
  @@unique([referralCodeId, refereeId], name: "uniq_code_referee")
  @@index([referrerId, createdAt])
  @@index([refereeId, createdAt])
}