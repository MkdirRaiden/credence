// prisma/enums/enums.prisma

enum UserRole {
  USER
  ADMIN
}

enum OtpChannel {
  SMS
  EMAIL
}

enum RedemptionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED    // Admin revokes an approved redemption
}

enum CreditEvent {
  ISSUE        // Referral bonus issued
  REVOKE       // Credits removed (user delete, term violation)
  REFUND       // Credits returned to user
  EXPIRE       // Auto-expiration
  ADJUSTMENT   // Admin manual correction/dispute resolution
}

enum IdempotencyScope {
  API
  JOB
}

enum IdempotencyStatus {
  STARTED
  SUCCEEDED
  FAILED
}
